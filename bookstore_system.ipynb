                    break
                else:
                    print("Invalid choice. Enter 1-5.")

        elif choice == '5':
            print("Thank you for using the Bookstore Inventory and Analytics System. Goodbye!")
            break

        else:
            print("Invalid choice. Enter 1-5.")

